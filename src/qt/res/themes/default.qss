/* Peercoin desktop theme. Keep font families native for platform and language support. */
QMainWindow, QDialog { background: #f4f7f5; color: #20382d; }
QWidget { color: #20382d; }
QLabel { background: transparent; }
QFrame { border: none; }

QPushButton, QToolButton {
    background: #237a4b;
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 7px 12px;
}
QPushButton:hover, QToolButton:hover { background: #1b653d; }
QPushButton:pressed, QToolButton:pressed, QPushButton:checked, QToolButton:checked { background: #164f32; }
QPushButton:focus, QToolButton:focus { border: 1px solid #71bb8d; }
QPushButton:disabled, QToolButton:disabled { background: #e0e7e2; color: #758279; }

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QAbstractSpinBox {
    background: #ffffff;
    color: #20382d;
    border: 1px solid #c9d5cd;
    border-radius: 5px;
    padding: 6px;
    selection-background-color: #d5ecdd;
    selection-color: #163e29;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QAbstractSpinBox:focus { border-color: #237a4b; }
QLineEdit:disabled, QComboBox:disabled, QAbstractSpinBox:disabled { background: #edf1ee; color: #758279; }
QComboBox { padding-right: 24px; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow { image: url(:/controls/caret-down); width: 7px; height: 7px; }
QComboBox QAbstractItemView { background: white; color: #20382d; selection-background-color: #d5ecdd; selection-color: #163e29; }

QTableView, QListView, QTreeView {
    background: #ffffff;
    alternate-background-color: #f5f8f6;
    color: #20382d;
    border: 1px solid #dce5df;
    border-radius: 6px;
    gridline-color: #e7ede9;
    selection-background-color: #d5ecdd;
    selection-color: #163e29;
}
QHeaderView::section { background: #edf3ef; color: #52675a; border: none; padding: 9px; }
QHeaderView::down-arrow { image: url(:/controls/caret-down); }
QHeaderView::up-arrow { image: url(:/controls/caret-up); }

/* A persistent sidebar: the existing QAction shortcuts and checked states remain active. */
QToolBar#walletNavigation { background: #153e2c; border: none; padding: 12px; spacing: 6px; }
QToolBar#walletNavigation QToolButton {
    background: transparent;
    color: #e1eee6;
    border-radius: 7px;
    padding: 12px;
    font-size: 14px;
    min-width: 160px;
}
QToolBar#walletNavigation QToolButton:hover { background: #214e38; }
QToolBar#walletNavigation QToolButton:checked { background: #2c6545; color: #ffffff; }
QToolBar#walletNavigation QToolButton:disabled { color: #799a85; }
QToolBar#walletNavigation QLabel { color: #b6cec0; padding: 4px 6px; }
QToolBar#walletNavigation QLabel#logo { padding: 14px 6px 28px 6px; }
QComboBox#walletSelector { min-width: 150px; max-width: 210px; }

QStatusBar { background: #ffffff; color: #52675a; border-top: 1px solid #dce5df; }
QStatusBar QLabel { color: #52675a; padding: 3px; }
QStatusBar::item { border: none; }

/* Overview cards. Balances keep their selectable, fixed-pitch values. */
#overviewTitle { font-size: 28px; font-weight: 600; color: #163e29; }
#activityPlaceholder { color: #687e70; font-size: 14px; }
#overviewSubtitle { color: #687e70; font-size: 14px; }
#OverviewPage QFrame#frame, #OverviewPage QFrame#frame_2 {
    background: #ffffff;
    border: 1px solid #dce5df;
    border-radius: 12px;
}
#OverviewPage QLabel#label_5, #OverviewPage QLabel#label_4 { font-size: 16px; font-weight: 600; }
#OverviewPage QLabel#labelBalance { color: #1b6c40; font-size: 24px; font-weight: 600; }
#OverviewPage QLabel#labelTotal { font-size: 16px; font-weight: 600; }
#OverviewPage QLabel#labelBalanceText, #OverviewPage QLabel#labelUnconfirmedText,
#OverviewPage QLabel#labelImmatureText, #OverviewPage QLabel#labelWatchonly,
#OverviewPage QLabel#labelSpendable { color: #687e70; }
#OverviewPage QFrame[frameShape="4"] { background: #e7ede9; max-height: 1px; border: none; }
#OverviewPage #listTransactions { background: transparent; border: none; }
#OverviewPage #labelAlerts { background: #fff3d9; color: #765218; border: 1px solid #ead5a5; border-radius: 6px; padding: 10px; }
#labelWalletStatus, #labelTransactionsStatus { background: #fff3d9; padding: 4px; border-radius: 5px; }
#labelWalletStatus:hover, #labelTransactionsStatus:hover { background: #f9e5ba; }

QTabWidget::pane { background: #ffffff; border: 1px solid #dce5df; }
QTabBar::tab { background: #edf3ef; color: #52675a; padding: 9px 16px; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { background: #ffffff; color: #1b6c40; border-bottom-color: #237a4b; }
QTabBar::tab:hover { background: #e2eee6; }
QScrollArea { background: transparent; border: none; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #bacbbf; border-radius: 5px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #8ba995; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QMenu, QMenuBar { background: #ffffff; color: #20382d; }
QMenu { border: 1px solid #dce5df; padding: 4px; }
QMenu::item { padding: 7px 24px; }
QMenu::item:selected, QMenuBar::item:selected { background: #e2eee6; }
QMenu::item:disabled { color: #8c9b92; }
QMenuBar::item { padding: 5px 9px; }
QToolTip { background: #153e2c; color: #ffffff; border: none; padding: 6px; }

/* About dialog */
QDialog[aboutDialog="true"] { background: #ffffff; }
QDialog[aboutDialog="true"] QFrame#aboutBrandPanel { background: #153e2c; }
QDialog[aboutDialog="true"] QLabel#aboutLogo { background: transparent; }
QDialog[aboutDialog="true"] QLabel#aboutProductName {
    color: #ffffff;
    font-size: 22px;
    font-weight: 600;
}
QDialog[aboutDialog="true"] QLabel#aboutProductType {
    color: #b6cec0;
    font-size: 13px;
}
QDialog[aboutDialog="true"] QFrame#aboutContentPanel { background: #ffffff; }
QDialog[aboutDialog="true"] QLabel#aboutTitle {
    color: #163e29;
    font-size: 24px;
    font-weight: 600;
}
QDialog[aboutDialog="true"] QLabel#aboutVersion {
    color: #687e70;
    font-size: 13px;
}
QDialog[aboutDialog="true"] QFrame#aboutDivider {
    background: #dce5df;
    border: none;
    max-height: 1px;
}
QDialog[aboutDialog="true"] QScrollArea#scrollArea,
QDialog[aboutDialog="true"] QWidget#scrollAreaWidgetContents,
QDialog[aboutDialog="true"] QLabel#aboutMessage {
    background: transparent;
}
QDialog[aboutDialog="true"] QLabel#aboutMessage {
    color: #52675a;
    font-size: 13px;
}
QDialog[aboutDialog="true"] QDialogButtonBox QPushButton {
    min-width: 76px;
    padding: 8px 18px;
}

/* Send page and optional coin-control panel */
QDialog#SendCoinsDialog { background: #f4f7f5; }
QDialog#SendCoinsDialog QScrollArea#scrollArea,
QDialog#SendCoinsDialog QWidget#scrollAreaWidgetContents {
    background: #f4f7f5;
}
QDialog#SendCoinsDialog QFrame#frameCoinControl,
QDialog#SendCoinsDialog QFrame#frameFee,
QWidget#SendCoinsEntry {
    background: #ffffff;
    border: 1px solid #dce5df;
    border-radius: 10px;
}
QDialog#SendCoinsDialog QWidget#widgetCoinControl,
QDialog#SendCoinsDialog QFrame#frameFeeSelection {
    background: #ffffff;
    border: none;
}
QDialog#SendCoinsDialog QFrame#frameCoinControl QLabel,
QDialog#SendCoinsDialog QFrame#frameFee QLabel,
QWidget#SendCoinsEntry QLabel {
    background: transparent;
    border: none;
}
QDialog#SendCoinsDialog QLabel#labelCoinControlFeatures,
QDialog#SendCoinsDialog QLabel#labelFeeHeadline {
    color: #163e29;
    font-size: 15px;
    font-weight: 600;
}
QDialog#SendCoinsDialog QLabel#labelCoinControlAutomaticallySelected,
QDialog#SendCoinsDialog QLabel#labelCoinControlQuantityText,
QDialog#SendCoinsDialog QLabel#labelCoinControlBytesText,
QDialog#SendCoinsDialog QLabel#labelCoinControlAmountText,
QDialog#SendCoinsDialog QLabel#labelCoinControlFeeText,
QDialog#SendCoinsDialog QLabel#labelCoinControlAfterFeeText,
QDialog#SendCoinsDialog QLabel#labelCoinControlChangeText {
    color: #687e70;
}
QDialog#SendCoinsDialog QPushButton#pushButtonCoinControl,
QDialog#SendCoinsDialog QPushButton#buttonChooseFee,
QDialog#SendCoinsDialog QPushButton#buttonMinimizeFee {
    background: #edf3ef;
    color: #1b6c40;
    border: 1px solid #c9d5cd;
}
QDialog#SendCoinsDialog QPushButton#pushButtonCoinControl:hover,
QDialog#SendCoinsDialog QPushButton#buttonChooseFee:hover,
QDialog#SendCoinsDialog QPushButton#buttonMinimizeFee:hover {
    background: #e2eee6;
    border-color: #8fb29c;
}
